# 管理员账号（管理页登录 + SMB 共享共用）
ADMIN_USER=admin

# 必填：管理员密码（管理页 + SMB 共用）。建议至少 12 位；
# 如需修改密码，改本文件后执行 docker compose up -d 重建容器即可生效
ADMIN_PASSWORD=请修改为强密码

# 选填：「记住此卷」的凭据加密密钥，留空即可——首次启动会自动在
# data/.secret_key 生成持久化随机密钥（开箱即用），容器重启后自动解锁仍然有效。
# 如想自行掌控密钥，可填一长随机串（openssl rand -base64 32），填了则优先使用。
# 无论哪种方式，一旦开始使用都请勿更换/删除密钥，否则已保存的卷凭据无法解密。
SECRET_KEY=

# 日志级别：INFO（默认）/ DEBUG
LOG_LEVEL=INFO

# 选填：SMB 宿主机映射端口，默认 445。
# 宿主机自带 SMB 占用 445 时改为其他端口（如 1445）；
# 注意 Windows 资源管理器只能走 445，改端口后需用 Linux/macOS/VLC 等客户端连接
SMB_HOST_PORT=445
