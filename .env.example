# 管理员账号（管理页登录 + SFTP 共用）
ADMIN_USER=admin

# 必填：管理员密码（管理页 + SFTP 共用）。建议至少 12 位；
# 如需修改密码，改本文件后执行 docker compose up -d 重建容器即可生效
ADMIN_PASSWORD=请修改为强密码

# 必填：「记住此卷」的凭据加密密钥，用它加密保存到 data/secrets.db
# 生成命令：openssl rand -base64 32
# 注意：此值一旦使用请勿更换，否则已保存的卷凭据将无法解密
SECRET_KEY=请替换为_openssl_rand_base64_32_的输出

# 日志级别：INFO（默认）/ DEBUG
LOG_LEVEL=INFO

# 选填：SFTP 宿主机映射端口，默认 2222（容器内固定监听 22）。
# 端口被占用时改为其他值，客户端用 sftp://<宿主机IP>:<端口> 连接
SFTP_HOST_PORT=2222
