# 版本控制
.git
.gitignore

# Python 缓存与虚拟环境（容器内由 uv 重新创建）
.venv
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# 本地数据与密钥
data/
data-test/
.env
*.env

# IDE / 编辑器
.idea/
.vscode/

# Docker 自身文件（运行时无需进入镜像）
Dockerfile
.dockerignore
docker-compose.yml

# 测试 / CI / 部署配置 / IDE 文档（仅宿主机或构建期使用，不进运行镜像）
tests/
.github/
deploy/
.trae/

# 本地运维脚本（可能含凭据，严禁入镜像）
ghcr_cleanup.py
